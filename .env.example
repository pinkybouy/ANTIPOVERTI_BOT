# GitHub Configuration
# Skopiuj ten plik do .env i wpisz swój token
GITHUB_TOKEN=your_github_token_here

# Engine Configuration
ENGINE_HOST=127.0.0.1
ENGINE_PORT=5555

# LLM Configuration
VLLM_API_URL=http://127.0.0.1:8000/v1
LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Harvester Configuration
BINANCE_PAIRS=btcusdt,btcusdc
BINANCE_STREAMS=trade,depth@100ms,bookTicker
HARVESTER_PORT=8000
